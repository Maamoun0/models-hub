// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  GUEST
  FREE
  PRO
  EDITOR
  ADMIN
}

enum ModelStatus {
  PUBLISHED
  DRAFT
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  name          String?
  role          UserRole       @default(FREE)
  plan          String         @default("Free")
  createdAt     DateTime       @default(now())
  lastLogin     DateTime?
  reviews       Review[]
  favorites     Favorite[]
  subscriptions Subscription[]
  comparisons   Comparison[]
  auditLogs     AuditLog[]
}

model Company {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  logoUrl     String?
  website     String?
  description String?
  models      AIModel[]
}

model AIModel {
  id               String      @id @default(uuid())
  slug             String      @unique
  name             String
  companyId        String
  company          Company     @relation(fields: [companyId], references: [id])
  shortDescription String
  fullDescription  String?
  logoUrl          String?
  websiteUrl       String?
  pricingInput     Decimal?    @db.Decimal(10, 4)
  pricingOutput    Decimal?    @db.Decimal(10, 4)
  hasFreeTier      Boolean     @default(false)
  contextWindow    Int?
  knowledgeCutoff  DateTime?
  categories       String[]
  capabilities     Json? // { code: 8, reasoning: 9, ... }
  pros             String[]
  cons             String[]
  status           ModelStatus @default(DRAFT)
  featured         Boolean     @default(false)
  score            Decimal?    @db.Decimal(5, 2)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  reviews          Review[]
  favorites        Favorite[]
}

model Comparison {
  id          String   @id @default(uuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  modelIds    String[]
  sharedToken String?  @unique
  createdAt   DateTime @default(now())
}

model Review {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  modelId   String
  model     AIModel  @relation(fields: [modelId], references: [id])
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  modelId   String
  model     AIModel  @relation(fields: [modelId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, modelId])
}

model Subscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  plan      String
  status    String
  startDate DateTime @default(now())
  endDate   DateTime?
  stripeId  String?  @unique
}

model AnalyticsEvent {
  id        String   @id @default(uuid())
  eventType String
  modelId   String?
  userId    String?
  sessionId String?
  createdAt DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(uuid())
  adminId    String
  admin      User     @relation(fields: [adminId], references: [id])
  action     String
  targetType String
  targetId   String
  changesJson Json?
  createdAt  DateTime @default(now())
}
